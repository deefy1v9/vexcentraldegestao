# Banco de dados
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vex_gestao?schema=public"

# Segredo de sessão do NextAuth. Gere com: openssl rand -base64 32
AUTH_SECRET=""

# URL pública da aplicação (usada no registro do webhook do CRM)
NEXTAUTH_URL="http://localhost:3000"

# Opcional — chave AES das credenciais de clientes.
# Sem valor, o app usa o AUTH_SECRET. ATENÇÃO: alterar esta chave (ou o
# AUTH_SECRET, quando ela não estiver definida) torna ilegíveis todas as
# senhas já gravadas no cofre de credenciais.
CREDENTIALS_SECRET=""

# Opcional — token que autentica o webhook público do CRM.
# Sem valor, é derivado do AUTH_SECRET.
CRM_WEBHOOK_SECRET=""

# Opcional — fallback da UAZAPI. O normal é configurar pela tela do CRM,
# que grava os valores cifrados na tabela SystemSettings.
UAZAPI_URL=""
UAZAPI_TOKEN=""

# Opcional — assistente de IA do CRM.
# O normal é configurar pela tela do CRM (guarda cifrado em SystemSettings).
# Esta variável serve como fallback.
ANTHROPIC_API_KEY=""
