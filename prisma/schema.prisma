generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COLABORADOR
}

enum TaskStatus {
  BACKLOG
  TODO
  EM_ANDAMENTO
  EM_REVISAO
  APROVADO // Aprovado para Agendamento — falta o agendamento para concluir
  CONCLUIDO
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        UserRole @default(COLABORADOR)
  phone       String?
  position    String? // função (Designer, Social Media...)
  // Especialidades usadas pela IA para sugerir o responsável
  // (ex: Design, Reels, Copywriting, Vídeo, Tráfego pago...)
  specialties String[] @default([])
  salary      Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activityLogs     ActivityLog[]
  crmMessages      CrmMessage[]
  assignedEvents   CalendarEvent[]
  assignedTasks    Task[]           @relation("TaskAssignee")
  createdTasks     Task[]           @relation("TaskCreator")
  producedTasks    Task[]           @relation("TaskProducer")
  reviewedTasks    Task[]           @relation("TaskReviewer")
  scheduledTasks   Task[]           @relation("TaskScheduler")
  taskComments     TaskComment[]
  taskEvents       TaskEvent[]
  salaryContracts  SalaryContract[]
  financialEntries FinancialEntry[]
  aiImports        AiImport[]

  assignedActivities CrmActivity[]      @relation("ActivityAssignee")
  createdActivities  CrmActivity[]      @relation("ActivityCreator")
  scheduledMessages  ScheduledMessage[]

  contractAnalyses ContractAnalysis[]
  confirmedPlans   PlanProposal[]     @relation("PlanConfirmedBy")
}

model Client {
  id             String    @id @default(cuid())
  name           String
  cnpj           String?   @unique
  email          String?
  phone          String?
  niche          String?
  contractStart  DateTime?
  contractEnd    DateTime?
  contractMonths Int?
  monthlyValue   Float?
  paymentDay     Int?
  status         String    @default("ATIVO")
  notes          String?
  // Segmentação da carteira: START | GROWTH | SCALE.
  // Automática pela faixa de ticket (configurável) ou manual por admin —
  // classificação manual nunca é sobrescrita pelo recálculo.
  tier           String?
  tierManual     Boolean   @default(false)
  tierChangedAt  DateTime?
  // Grupo operacional de publicação (A: seg/qua/sex, B: ter/qui/sáb).
  // Definido pelo planejamento e reutilizado nas próximas análises.
  operationalGroup String?

  // ------- Faturamento (Asaas) e NFS-e (Focus) — ativação individual -------
  billingEnabled    Boolean   @default(false) // cobrança automática mensal
  legalName         String? // razão social (tomador da NFS-e)
  municipalReg      String? // inscrição municipal, quando aplicável
  billingEmail      String? // e-mail financeiro (recebe boleto e NFS-e)
  extraEmails       String? // e-mails adicionais, separados por vírgula
  zipCode           String?
  street            String?
  addressNumber     String?
  complement        String?
  district          String?
  city              String?
  state             String?
  ibgeCode          String? // código IBGE do município do tomador
  billingLeadDays   Int       @default(10) // antecedência da geração da cobrança
  billingType       String    @default("UNDEFINED") // BOLETO | PIX | UNDEFINED
  nfseEnabled       Boolean   @default(false) // emissão automática de NFS-e
  // ON_CONFIRMED (padrão) | ON_RECEIVED | ON_COMPETENCE | MANUAL
  nfseRule          String    @default("ON_CONFIRMED")
  fiscalDescription String? // discriminação padrão do serviço na nota
  asaasCustomerId   String?   @unique // ID do cliente no Asaas (somente leitura)
  asaasSyncStatus   String? // OK | ERRO | null (nunca sincronizado)
  asaasSyncError    String?
  asaasSyncedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credentials          ClientCredential[]
  services             ClientService[]
  calendarEvents       CalendarEvent[]
  payments             ClientPayment[]
  crmContact           CrmContact?
  tasks                Task[]
  paymentConfirmations PaymentConfirmation[]
  tierHistory          ClientTierHistory[]
  asaasCharges         AsaasCharge[]
  contractAnalyses     ContractAnalysis[]
  planProposals        PlanProposal[]
}

// ---------------------------------------------------------------------------
// Planejamento operacional com IA: contrato → análise → proposta → demandas.
// Nada aqui cria demanda sozinho; a criação continua no módulo de Demandas.
// ---------------------------------------------------------------------------

// Análise estruturada de um contrato (ou dos serviços ativos) pela IA.
model ContractAnalysis {
  id          String   @id @default(cuid())
  clientId    String
  createdById String
  serviceIds  String[] @default([]) // serviços considerados na análise
  fileName    String?
  fileHash    String? // sha256 do contrato — detecta reanálise do mesmo arquivo
  model       String
  // ANALISANDO | REVISAO | CONFIRMADO | ERRO | CANCELADO
  status      String   @default("ANALISANDO")
  adminNote   String? // instrução do administrador (fonte confiável)
  extraction  Json? // saída da IA já validada por schema
  confidence  Float?
  warnings    String[] @default([])
  missing     String[] @default([]) // informações ausentes no contrato
  error       String?
  durationMs  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id])
  proposal  PlanProposal?

  @@index([clientId, createdAt])
}

// Proposta de calendário gerada a partir da análise — sempre passa por
// revisão do administrador antes de virar demanda.
model PlanProposal {
  id            String    @id @default(cuid())
  analysisId    String    @unique
  clientId      String
  // REVISAO | CONFIRMADO | CANCELADO
  status        String    @default("REVISAO")
  weekGroup     String? // A | B | null (dias vieram do contrato)
  groupReason   String?
  summary       Json? // justificativas, notas de distribuição, contadores
  confirmedAt   DateTime?
  confirmedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  analysis    ContractAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  confirmedBy User?            @relation("PlanConfirmedBy", fields: [confirmedById], references: [id])
  items       PlanItem[]

  @@index([clientId, status])
}

// Item sugerido do planejamento. `ref` é determinístico
// (plan:{clientId}:{servico}:{competencia}:{seq}) — reexecutar a análise
// reaproveita o item em vez de duplicar a demanda.
model PlanItem {
  id           String    @id @default(cuid())
  planId       String
  ref          String
  clientId     String
  serviceId    String?
  serviceKey   String
  title        String
  description  String?
  contentType  String?
  platform     String?
  competence   String // YYYY-MM
  sequence     Int       @default(1)
  publishAt    DateTime
  productionAt DateTime?
  reviewAt     DateTime?
  approvalAt   DateTime?
  scheduleAt   DateTime?
  assigneeId   String?
  reviewerId   String?
  schedulerId  String?
  priority     String    @default("MEDIA")
  weekGroup    String? // A | B
  // CONTRATO (dado explícito) | IA (sugestão) | MANUAL (editado pelo admin)
  origin       String    @default("IA")
  sourceRef    String? // trecho/página do contrato que originou o item
  confidence   Float?
  conflicts    Json? // conflitos detectados na prévia
  notes        String[]  @default([])
  // PENDENTE | APROVADO | DESCARTADO | CRIADO
  status       String    @default("PENDENTE")
  createdTaskId String?  @unique
  editedFields String[]  @default([]) // auditoria do que o admin mudou
  editNote     String?
  suggested    Json? // sugestão original da IA, preservada após edição
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  plan PlanProposal @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, ref])
  @@index([clientId, publishAt])
  @@index([ref])
}

// Cobrança gerada no Asaas — uma por cliente e competência (unique).
// Valores em Decimal (numeric), nunca float. A fonte dos valores é o
// sistema (soma dos serviços válidos na competência), não o Asaas.
model AsaasCharge {
  id                  String    @id @default(cuid())
  clientId            String
  year                Int
  month               Int
  asaasId             String?   @unique // id da cobrança no Asaas
  externalRef         String    @unique // billing:{clientId}:{YYYY-MM}
  billingType         String    @default("UNDEFINED") // BOLETO | PIX | UNDEFINED
  value               Decimal   @db.Decimal(12, 2) // bruto
  netValue            Decimal?  @db.Decimal(12, 2) // líquido informado pelo Asaas
  fee                 Decimal?  @db.Decimal(12, 2) // tarifa
  dueDate             DateTime
  // PENDING | CONFIRMED | RECEIVED | OVERDUE | REFUNDED | PARTIALLY_REFUNDED
  // | CANCELLED | DELETED | ERROR
  status              String    @default("PENDING")
  invoiceUrl          String?
  bankSlipUrl         String?
  identificationField String? // linha digitável
  barCode             String?
  confirmedAt         DateTime? // pagamento confirmado (saldo pode não estar disponível)
  paidAt              DateTime? // data de pagamento informada pelo Asaas
  receivedAt          DateTime? // saldo disponível
  creditDate          DateTime?
  // Guardas de contabilização única (receita/tarifa nunca em dobro)
  revenueBookedAt     DateTime?
  feeBookedAt         DateTime?
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  client Client       @relation(fields: [clientId], references: [id])
  nfse   NfseInvoice?

  @@unique([clientId, year, month])
}

// Configuração fiscal do prestador (linha única, id fixo "default").
// Tokens NUNCA ficam aqui — vivem em SystemSettings/env, fora do GET.
model FiscalConfig {
  id                     String   @id @default("default")
  cnpj                   String?
  razaoSocial            String?
  inscricaoMunicipal     String?
  codigoMunicipio        String? // IBGE do prestador
  optanteSimples         Boolean  @default(true)
  regimeEspecial         String?
  naturezaOperacao       String?
  incentivadorCultural   Boolean  @default(false)
  codigoServicoMunicipal String?
  itemListaServico       String?
  cnae                   String?
  codigoTributacao       String?
  aliquotaIss            Decimal? @db.Decimal(6, 4)
  issRetido              Boolean  @default(false)
  pis                    Decimal? @db.Decimal(6, 4)
  cofins                 Decimal? @db.Decimal(6, 4)
  csll                   Decimal? @db.Decimal(6, 4)
  inss                   Decimal? @db.Decimal(6, 4)
  ibsCbs                 String? // configuração IBS/CBS conforme regra vigente
  descricaoPadrao        String?
  // Chave de autenticação do Web Service da prefeitura já cadastrada na Focus
  // (a chave em si vive na Focus — aqui só o estado, nunca o segredo).
  wsKeyConfigured        Boolean  @default(false)
  autoEmit               Boolean  @default(false)
  emitRule               String   @default("ON_CONFIRMED")
  updatedAt              DateTime @updatedAt
}

// Alíquota efetiva do ISS por competência (Simples Nacional: 2% a 5%,
// confirmada pelo contador a cada mês). Sem registro, não há emissão.
model FiscalAliquota {
  id          String   @id @default(cuid())
  year        Int
  month       Int
  aliquotaIss Decimal  @db.Decimal(6, 4)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([year, month])
  @@index([year, month])
}

// NFS-e emitida via Focus — no máximo uma por cobrança.
model NfseInvoice {
  id                String    @id @default(cuid())
  chargeId          String    @unique
  focusRef          String    @unique // nfse:{chargeId}
  // PROCESSANDO | AUTORIZADO | ERRO_AUTORIZACAO | CANCELADO | ERRO_CANCELAMENTO
  status            String    @default("PROCESSANDO")
  numero            String?
  codigoVerificacao String?
  pdfUrl            String?
  xmlUrl            String?
  municipalMessage  String?
  lastError         String?
  issuedAt          DateTime?
  emailSentAt       DateTime?
  emailRecipients   String?
  emailAttempts     Int       @default(0)
  emailError        String?
  emailRequestedBy  String?
  raw               Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  charge AsaasCharge @relation(fields: [chargeId], references: [id])
}

// Evento de webhook recebido (Asaas/Focus) — chave única = idempotência.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String // ASAAS | FOCUS
  eventKey    String    @unique // id do evento ou hash determinístico
  type        String?
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
}

// Tentativas de chamadas às integrações (auditoria e diagnóstico).
model IntegrationLog {
  id        String   @id @default(cuid())
  provider  String // ASAAS | FOCUS
  action    String
  refId     String?
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())
}

// Histórico de mudanças de grupo do cliente — nunca é apagado.
model ClientTierHistory {
  id        String   @id @default(cuid())
  clientId  String
  fromTier  String?
  toTier    String?
  ticket    Float // ticket mensal no momento da mudança
  manual    Boolean // true = definido por admin; false = recálculo automático
  userId    String? // quem alterou (null nas automáticas)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientCredential {
  id        String   @id @default(cuid())
  clientId  String
  type      String
  label     String
  username  String?
  password  String?
  url       String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientService {
  id                 String    @id @default(cuid())
  clientId           String
  serviceName        String
  customName         String?
  description        String?
  monthlyValue       Float?
  paymentType        String?
  contractDuration   Int?
  firstPaymentDate   DateTime?
  totalContractValue Float?
  observations       String?
  startDate          DateTime?
  endDate            DateTime?
  status             String    @default("ATIVO")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payments ClientPayment[]
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  type        String    @default("ENTREGA")
  status      String    @default("PENDENTE")
  clientId    String?
  assignedTo  String?
  createdAt   DateTime  @default(now())

  client       Client? @relation(fields: [clientId], references: [id])
  assignedUser User?   @relation(fields: [assignedTo], references: [id])
}

model Task {
  id          String       @id @default(cuid())
  // Número sequencial exibido como #1, #2... — identificação humana da demanda
  number      Int          @unique @default(autoincrement())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIA)
  dueDate     DateTime? // data final (agendamento/publicação/entrega)
  clientId    String?
  assigneeId  String? // responsável ATUAL (muda conforme a etapa)
  creatorId   String
  position    Int          @default(0)
  tags        String[]
  platform    String? // Instagram, LinkedIn, Facebook, site...
  contentType String? // post, carrossel, reels, story, artigo, vídeo...
  // Origem em importação com IA (auditoria/deduplicação)
  importId    String?

  // Papéis fixos do fluxo de produção. Prazos derivados da data final:
  // produção = D-2, revisão = D-1, agendamento/entrega = D.
  producerId  String?
  reviewerId  String?
  schedulerId String?

  // Produção → revisão
  driveLink       String?
  driveLinkSentAt DateTime?
  driveLinkSentBy String?

  // Revisão
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  // Agendamento (conclui a demanda)
  scheduledById     String?
  scheduledAt       DateTime? // quando foi confirmado
  scheduledFor      DateTime? // data/hora do agendamento em si
  scheduledPlatform String?
  publicationLink   String?
  scheduleNote      String?

  // Lembretes automáticos (uma vez cada; nunca mudam o status)
  reminderProductionAt DateTime?
  reminderReviewAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client      Client?          @relation(fields: [clientId], references: [id])
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator     User             @relation("TaskCreator", fields: [creatorId], references: [id])
  producer    User?            @relation("TaskProducer", fields: [producerId], references: [id])
  reviewer    User?            @relation("TaskReviewer", fields: [reviewerId], references: [id])
  scheduler   User?            @relation("TaskScheduler", fields: [schedulerId], references: [id])
  comments    TaskComment[]
  attachments TaskAttachment[]
  events      TaskEvent[]
}

// Linha do tempo da demanda: cada ação relevante vira um registro imutável.
// Nada é apagado quando a demanda volta para ajustes.
model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  // CRIACAO | STATUS | RESPONSAVEL | LINK_DRIVE | ENVIO_REVISAO | APROVACAO |
  // AJUSTES | AGENDAMENTO | LEMBRETE | JUSTIFICATIVA | AVISO
  kind      String
  detail    String
  createdAt DateTime @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  fileName  String
  fileUrl   String
  fileSize  Int
  fileType  String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  module    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model FinancialEntry {
  id          String    @id @default(cuid())
  type        String // CUSTO | SALARIO | RECEITA
  category    String
  name        String?
  description String
  amount      Float
  date        DateTime
  // Competência do lançamento (mês/ano a que ele pertence)
  month       Int?
  year        Int?
  dueDate     DateTime?
  paidAt      DateTime?
  // PENDENTE | PAGO | CANCELADO — CANCELADO funciona como "lápide" de uma
  // ocorrência recorrente excluída: mantém a chave única para o período não
  // ser re-materializado, mas sai das listagens e dos cálculos.
  status      String    @default("PENDENTE")
  isPaid      Boolean   @default(false)
  clientId    String?
  userId      String?
  recurring   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  // Origem recorrente (custo ou salário); no máximo uma ocorrência por período
  recurringCostId  String?
  salaryContractId String?
  recurringCost    RecurringCost?  @relation(fields: [recurringCostId], references: [id], onDelete: SetNull)
  salaryContract   SalaryContract? @relation(fields: [salaryContractId], references: [id], onDelete: SetNull)
  user             User?           @relation(fields: [userId], references: [id])

  @@unique([recurringCostId, year, month])
  @@unique([salaryContractId, year, month])
}

// Modelo (template) de custo recorrente. As ocorrências mensais são
// materializadas em FinancialEntry — uma por período, sem duplicidade.
model RecurringCost {
  id          String    @id @default(cuid())
  name        String
  description String?
  category    String
  amount      Float
  frequency   String    @default("MENSAL") // MENSAL | TRIMESTRAL | ANUAL
  startDate   DateTime
  endDate     DateTime?
  dueDay      Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  entries FinancialEntry[]
}

// Contrato de salário de um colaborador. Mudanças de valor "a partir deste
// mês" encerram o contrato vigente e abrem um novo — os meses já
// materializados preservam o valor da época.
model SalaryContract {
  id         String   @id @default(cuid())
  userId     String
  amount     Float
  payDay     Int      @default(5)
  startYear  Int
  startMonth Int
  endYear    Int?
  endMonth   Int?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  user    User             @relation(fields: [userId], references: [id])
  entries FinancialEntry[]
}

model ClientPayment {
  id              String    @id @default(cuid())
  clientId        String
  serviceId       String?
  month           Int
  year            Int
  amount          Float
  dueDate         DateTime
  paidAt          DateTime?
  status          String    @default("PENDENTE")
  // Conta em que o valor entrou (confirmações via WhatsApp)
  receivedAccount String?
  createdAt       DateTime  @default(now())

  client  Client         @relation(fields: [clientId], references: [id])
  service ClientService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
}

// Ciclo de confirmação de recebimento via WhatsApp: uma cobrança por
// competência (cliente + mês/ano), enviada D-2 aos administradores.
model PaymentConfirmation {
  id              String    @id @default(cuid())
  code            String    @unique // código curto citado na conversa (#AB12)
  clientId        String
  year            Int
  month           Int
  amount          Float // saldo pendente no momento do envio
  dueDate         DateTime
  // AGUARDANDO | AGUARDANDO_VALOR | AGUARDANDO_CONTA | CONFIRMADO | PARCIAL
  status          String    @default("AGUARDANDO")
  // Último estágio de lembrete enviado: D2 (2 dias antes) → D0 (vence hoje)
  // → OVERDUE (vencido sem pagamento). Cada estágio dispara no máximo uma vez.
  stage           String    @default("D2")
  sentAt          DateTime  @default(now())
  sentTo          String // números notificados, separados por vírgula
  // Fluxos de duas etapas (valor parcial / escolha de conta) ficam presos
  // ao número que iniciou a resposta
  actionPhone     String?
  pendingValue    Float?
  respondedBy     String? // userId do admin que confirmou
  respondedByName String?
  respondedPhone  String?
  respondedAt     DateTime?
  receivedAccount String?
  createdAt       DateTime  @default(now())

  client Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  events PaymentConfirmationEvent[]

  @@unique([clientId, year, month])
}

// Trilha de auditoria da confirmação: envios, respostas, pagamentos e falhas.
model PaymentConfirmationEvent {
  id             String   @id @default(cuid())
  confirmationId String
  kind           String // ENVIO | RESPOSTA | PAGAMENTO | AVISO | ERRO
  phone          String?
  detail         String
  createdAt      DateTime @default(now())

  confirmation PaymentConfirmation @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
}

model CrmContact {
  id             String    @id @default(cuid())
  clientId       String?   @unique
  name           String?
  whatsappNumber String    @unique
  uazapiChatId   String?
  lastMessage    DateTime?
  createdAt      DateTime  @default(now())

  client        Client?            @relation(fields: [clientId], references: [id])
  conversations CrmConversation[]
  activities    CrmActivity[]
  scheduled     ScheduledMessage[]
}

model CrmConversation {
  id        String   @id @default(cuid())
  contactId String
  title     String?
  status    String   @default("ABERTO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact  CrmContact   @relation(fields: [contactId], references: [id])
  messages CrmMessage[]
  drafts   AiDraft[]
  aiJobs   AiJob[]
}

model CrmMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String?
  senderName     String?
  content        String
  messageType    String   @default("TEXT")
  fromClient     Boolean  @default(false)
  uazapiMsgId    String?
  sentAt         DateTime @default(now())

  conversation CrmConversation @relation(fields: [conversationId], references: [id])
  sender       User?           @relation(fields: [senderId], references: [id])
}

model SystemSettings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Importação de calendário/briefing analisada pela IA (Gemini).
// A IA nunca cria demanda sozinha: os itens ficam em revisão até um
// administrador confirmar. Serve também de auditoria e deduplicação.
model AiImport {
  id           String   @id @default(cuid())
  createdById  String
  fileName     String?
  fileHash     String? // sha256 do conteúdo — detecta reimportação
  model        String
  // ANALISANDO | REVISAO | CONFIRMADO | ERRO
  status       String   @default("ANALISANDO")
  itemsFound   Int      @default(0)
  itemsCreated Int      @default(0)
  itemsIgnored Int      @default(0)
  error        String?
  createdAt    DateTime @default(now())

  createdBy User           @relation(fields: [createdById], references: [id])
  items     AiImportItem[]
}

model AiImportItem {
  id            String   @id @default(cuid())
  importId      String
  sourceItem    String? // linha/página/referência original no documento
  payload       Json // sugestão completa extraída/editada
  // PENDENTE | CRIADO | IGNORADO
  status        String   @default("PENDENTE")
  createdTaskId String? // idempotência: item já virou demanda
  createdAt     DateTime @default(now())

  import AiImport @relation(fields: [importId], references: [id], onDelete: Cascade)
}

// Notificações do sininho são derivadas (pagamentos atrasados, tarefas
// concluídas) — esta tabela guarda o que cada usuário já marcou como lido,
// para a dispensa sobreviver a navegação e novos logins.
model NotificationDismissal {
  id        String   @id @default(cuid())
  userId    String
  notifId   String
  createdAt DateTime @default(now())

  @@unique([userId, notifId])
}

/// Atividade de relacionamento do CRM (ligação, follow-up, reunião, proposta).
/// Separado de Task: Task é entrega de trabalho no Kanban, atividade é contato
/// comercial com o cliente.
model CrmActivity {
  id          String    @id @default(cuid())
  contactId   String
  type        String    @default("FOLLOWUP")
  title       String
  notes       String?
  dueDate     DateTime
  status      String    @default("PENDENTE")
  assigneeId  String?
  createdById String?
  createdByAi Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contact   CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee  User?      @relation("ActivityAssignee", fields: [assigneeId], references: [id])
  createdBy User?      @relation("ActivityCreator", fields: [createdById], references: [id])

  @@index([status, dueDate])
  @@index([contactId])
}

/// Mensagem de WhatsApp agendada para envio futuro. O despachante roda a cada
/// minuto e envia o que estiver vencido.
model ScheduledMessage {
  id             String    @id @default(cuid())
  contactId      String?
  whatsappNumber String
  content        String
  scheduledFor   DateTime
  status         String    @default("PENDENTE")
  attempts       Int       @default(0)
  lastError      String?
  sentAt         DateTime?
  createdById    String?
  createdByAi    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  contact   CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy User?       @relation(fields: [createdById], references: [id])

  @@index([status, scheduledFor])
}

/// Ação que a IA quer executar e que só roda depois de confirmação humana no
/// chat de comando. É o freio entre "a IA entendeu" e "o cliente recebeu".
model AiPendingAction {
  id          String    @id @default(cuid())
  commandChat String
  toolName    String
  payload     String
  summary     String
  status      String    @default("AGUARDANDO")
  resultInfo  String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  resolvedAt  DateTime?

  @@index([commandChat, status])
}

/// Sugestão de resposta gerada pela IA para uma mensagem de cliente. Nunca é
/// enviada sozinha: aparece no CRM para aprovação com um clique.
model AiDraft {
  id             String    @id @default(cuid())
  conversationId String
  content        String
  basedOnMsgId   String?
  status         String    @default("PENDENTE")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  conversation CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
}

/// Fila durável do agente. O webhook grava o job e responde 200 na hora; o
/// processamento roda em background e, se o container cair no meio, o
/// despachante reprocessa o que ficou preso.
model AiJob {
  id             String    @id @default(cuid())
  conversationId String
  commandChat    String
  incomingText   String
  status         String    @default("PENDENTE")
  attempts       Int       @default(0)
  lastError      String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  conversation CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}
